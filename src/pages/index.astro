---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-6 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-4 sm:grid-cols-[1fr_1fr_auto]"
            data-testid="game-filters"
          >
            <div>
              <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
              <select
                id="category-filter"
                name="categories"
                multiple
                class="min-h-28 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="category-filter"
                aria-describedby="category-filter-help"
              >
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
              <p id="category-filter-help" class="mt-2 text-sm text-slate-400">Choose one or more categories.</p>
            </div>

            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>

            <button
              type="reset"
              class="self-end rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </form>

          <p class="mb-4 text-slate-300" role="status" aria-live="polite" data-testid="filter-results"></p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="mt-6 hidden text-slate-300" data-testid="no-filter-results">No games match the selected filters.</p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  function applyFilters(): void {
    if (!categoryFilter || !publisherFilter || !results || !noResults) return;

    const categoryIds = new Set(Array.from(categoryFilter.selectedOptions, (option) => option.value));
    const publisherId = publisherFilter.value;
    let visibleGames = 0;

    for (const card of cards) {
      const matchesCategory = categoryIds.size === 0 || categoryIds.has(card.dataset.categoryId ?? '');
      const matchesPublisher = publisherId === '' || publisherId === card.dataset.publisherId;
      const isVisible = matchesCategory && matchesPublisher;
      card.hidden = !isVisible;
      visibleGames += Number(isVisible);
    }

    results.textContent = `${visibleGames} ${visibleGames === 1 ? 'game' : 'games'} found`;
    noResults.hidden = visibleGames !== 0;
  }

  form?.addEventListener('change', applyFilters);
  form?.addEventListener('reset', () => window.setTimeout(applyFilters));
  applyFilters();
</script>
